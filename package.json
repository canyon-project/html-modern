{
  "name": "@canyonjs/html-modern",
  "version": "0.1.0",
  "description": "Modern Istanbul HTML coverage report React component library + single-file HTML page",
  "keywords": [
    "coverage",
    "html",
    "istanbul",
    "react",
    "report",
    "canyon"
  ],
  "license": "MIT",
  "author": "Travis Zhang <https://github.com/travzhang>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyon-project/html-modern.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:page",
    "build:lib": "tsdown",
    "build:page": "vite build",
    "dev": "vite",
    "play": "vite --config vite.config.playground.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-highlight-words": "^0.20.1",
    "@vitejs/plugin-react": "^6.1.0",
    "antd": "^6.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-highlight-words": "^0.21.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "antd": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-highlight-words": "^0.21.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
